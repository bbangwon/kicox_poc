# ingest 설정 예시. 복사해 .env로 쓴다 (커밋 금지). AI 서버 주소(EMBED_BASE_URL)는 worker-ai-endpoints.env에서 읽는다
KICOX_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/kicox
QDRANT_URL=http://localhost:6333
# 전처리 산출물 위치 (기본: ../kicox_regulation_prep/data/docs)
# INGEST_SRC=
# BM25 avgdl: 첫 sync가 알려 주는 실측값으로 고정. 바꾸면 전체 재색인
RAG_BM25_AVGDL_CATALOG=
RAG_BM25_AVGDL_CHUNKS=
